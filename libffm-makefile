CXX ?= g++
CXXFLAGS = -Wall -O3 -std=c++17 -march=native -fPIC -shared

DFLAG += -DUSESSE

DFLAG += -DUSEOMP
CXXFLAGS += -fopenmp

all: ffm.o timer.o

ffm.o: ffm.cpp ffm.h timer.o
	$(CXX) $(CXXFLAGS) $(DFLAG) -c -o $@ $<

timer.o: timer.cpp timer.h
	$(CXX) $(CXXFLAGS) $(DFLAG) -c -o $@ $<

clean:
	rm -f ffm.o timer.o
