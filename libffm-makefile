CXX ?= g++
CXXFLAGS = -Wall -O3 -shared -std=c++14 -march=native -fPIC

# must always use sse and openmp for pyffm
DFLAG += -DUSESSE

DFLAG += -DUSEOMP
CXXFLAGS += -fopenmp

all: ffm.o timer.o

ffm.o: ffm.cpp ffm.h timer.o
	-git apply ../libffm_more_info.patch 2> /dev/null
	$(CXX) $(CXXFLAGS) $(DFLAG) -c -o $@ $<

timer.o: timer.cpp timer.h
	-git apply ../libffm_more_info.patch 2> /dev/null
	$(CXX) $(CXXFLAGS) $(DFLAG) -c -o $@ $<

clean:
	rm -f ffm.o timer.o
